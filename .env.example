# Firebase Configuration
# Copy this file to .env and fill in your actual values from Firebase Console
# Project Settings > General > Your apps > SDK setup

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=lab1mma.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=lab1mma
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=lab1mma.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here
